# Copy this file to ".env" in this same folder (backend/), then set your keys.
# The app only reads ".env" — editing ".env.example" alone does nothing.

GOOGLE_API_KEY=your-api-key-here

# Optional:
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# Local MySQL (development only - localhost)
MYSQL_ENABLED=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=RECAI
MYSQL_USER=root
MYSQL_PASSWORD=your-mysql-password
