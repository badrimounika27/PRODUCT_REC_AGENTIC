# Copy this file to ".env" in this same folder (backend/), then set your own values.
# The app only reads ".env" at runtime. Editing ".env.example" alone does nothing.
# Never commit ".env" (it is gitignored). Each developer uses their own local credentials.

GOOGLE_API_KEY=your-api-key-here

# Optional:
# GEMINI_API_KEY=your-api-key-here
# GEMINI_MODEL=gemini-2.0-flash

# ---------------------------------------------------------------------------
# MySQL (environment-specific - set these for your local machine)
# ---------------------------------------------------------------------------
# MYSQL_ENABLED=false disables DB sync without removing other settings.
MYSQL_ENABLED=true
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=your_database_name
MYSQL_USER=your_mysql_user
MYSQL_PASSWORD=your_mysql_password
